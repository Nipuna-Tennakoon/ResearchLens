# Required only for title extraction during ingestion and for the answer model.
# Local embeddings (the default) need no key.
OPENAI_API_KEY=sk-...

# Milvus connection (defaults match docker-compose.yml)
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=paper_chunks_2

# Embeddings: "huggingface" runs a local BERT model, "openai" calls the API.
# EMBED_MODEL and EMBED_DIM default to the right pair for the provider.
EMBED_PROVIDER=huggingface
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# Answer model
LLM_MODEL=gpt-4o-mini

# Chunking
CHUNK_SIZE=150
CHUNK_OVERLAP=10
EXTRACT_TITLES=true

# Answer model temperature
TEMPERATURE=0

# Retrieval: SEARCH_LIMIT candidates come back from Milvus, the cross-encoder
# reranker reads each one against the question, and the best TOP_K are used.
SEARCH_LIMIT=10
TOP_K=3
RERANK=true
RERANK_MODEL=BAAI/bge-reranker-base
